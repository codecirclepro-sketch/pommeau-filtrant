# Copy to .env.local and fill in. .env.local is never committed and never pasted into a chat.
# On the VPS: ~/pommeau-filtrant/.env.local, with the same keys except the "local only" ones.

# Stripe (dashboard.stripe.com > Developers > API keys). sk_test_... first, sk_live_... at launch.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Developers > Webhooks > the endpoint > Signing secret): whsec_...
STRIPE_WEBHOOK_SECRET=

# The shop's mailbox (Hostinger): order confirmations, order alerts, withdrawal acknowledgments.
# Without them nothing is sent and the dashboard says so. SMTP_HOST and SMTP_PORT default to smtp.hostinger.com:465.
SMTP_USER=contact@pommeau-filtrant.fr
SMTP_PASSWORD=
# Where the shop's alerts go, if not to SHOP.email (src/content/shop.ts).
# MAIL_ADMIN=

# Password of the dashboard (/admin, user "admin"): at least 12 characters. Without it the dashboard is closed.
ADMIN_PASSWORD=

# Where orders and visit counts are written. On the VPS: /home/<user>/pommeau-filtrant-data (set in ecosystem.config.cjs).
# DATA_DIR=

# Local only
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SHOW_DRAFTS=1
# Write e-mails to DATA_DIR/outbox instead of sending them.
MAIL_OUTBOX=1
